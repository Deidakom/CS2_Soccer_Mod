	// 2026-09-25 owner: our kick sound replaces the knife's wall-hit thud.
	// Same name as Valve's event (soundevents/game_sounds_weapons.vsndevts)
	// with zero volume, so the knife is silent on the ball and on walls,
	// also for the player who swings (their game plays it locally).
	"Weapon_Knife.HitWall" =
	{
		type = "csgo_mega"
		volume = 0.0
		vsnd_files_track_01 = "sounds/weapons/knife/knife_hit_01.vsnd"
	}
