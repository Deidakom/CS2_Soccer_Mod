<!--
  SoccerMod match HUD (custom_hud_layout, driven by the server plugin,
  SoccerModMvpPlugin.ScoreHud.cs). Same rules as soccermod_menu.xml: no id on
  the root, only Panel and Label, texts as {s:text}, no inline styles.
  The plugin sets "shown" on sm_hud while a match runs; the status pill gets
  one st-* class (st-kickoff, st-live, st-goal, st-break, st-paused, st-final)
  and the banner "shown" plus one bn-* class (bn-start, bn-goal-red,
  bn-goal-blue, bn-break, bn-final). Since 2026-09-26 the events play in
  sm_flash over the scoreboard instead (fl-* classes, same names).
-->
<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/soccermod_scorebug.vcss_c" />
	</styles>

	<Panel class="sm-hud-screen" hittest="false">
	<Panel id="sm_hud" class="sm-hud" hittest="false">
		<!-- sm-top: the bar and the status line, with the event overlay
		     (GOAL, OWN GOAL, MATCH START, HALF-TIME, FULL TIME) on top of both -->
		<Panel class="sm-top" hittest="false">
			<Panel class="sm-stack" hittest="false">
				<!-- sm_row: the bar between two wings that cover CS2 own avatars; the
				     plugin sets wn-<n> (width n x 20 px) and pc-<n> (little players shown) -->
				<Panel id="sm_row" class="sm-row" hittest="false">
				<Panel class="sm-wing sm-wing-red" hittest="false">
					<Panel id="sm_wing_red" class="sm-people sm-people-red" hittest="false">
						<Panel class="sm-man sm-man-1" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-2" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-3" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-4" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-5" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-6" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-7" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-8" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-9" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-10" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
					</Panel>
				</Panel>
				<Panel class="sm-bug" hittest="false">
					<Label id="sm_team_red" class="sm-team sm-team-red" text="{s:text}" />
					<Label id="sm_score_red" class="sm-num sm-num-red" text="{s:text}" />
					<Panel class="sm-clockbox" hittest="false">
						<Label id="sm_clock" class="sm-clock" text="{s:text}" />
						<Label id="sm_period" class="sm-period" text="{s:text}" />
					</Panel>
					<Label id="sm_score_blue" class="sm-num sm-num-blue" text="{s:text}" />
					<Label id="sm_team_blue" class="sm-team sm-team-blue" text="{s:text}" />
				</Panel>
				<Panel class="sm-wing sm-wing-blue" hittest="false">
					<Panel id="sm_wing_blue" class="sm-people sm-people-blue" hittest="false">
						<Panel class="sm-man sm-man-1" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-2" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-3" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-4" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-5" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-6" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-7" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-8" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-9" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
						<Panel class="sm-man sm-man-10" hittest="false"><Panel class="sm-man-head" hittest="false" /><Panel class="sm-man-body" hittest="false" /></Panel>
					</Panel>
				</Panel>
				</Panel>
				<Label id="sm_status" class="sm-status" text="{s:text}" />
			</Panel>
			<Panel id="sm_flash" class="sm-flash" hittest="false">
				<Label id="sm_flash_main" class="sm-flash-main" text="{s:text}" />
				<Label id="sm_flash_sub" class="sm-flash-sub" text="{s:text}" />
			</Panel>
		</Panel>
	</Panel>
	</Panel>
</root>
