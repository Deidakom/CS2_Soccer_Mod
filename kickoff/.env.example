# Copy to .env. Generate each secret independently with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KICKOFF_ORIGIN=https://your-domain.example.com
SESSION_SECRET=
RCON_HELPER_SECRET=
KICKOFF_OWNER_STEAM_ID=

# The private Docker network gateway must match the helper's bind address.
# Choose a subnet that does not overlap your host's existing networks.
KICKOFF_SUBNET=172.30.20.0/24
RCON_HELPER_BIND=172.30.20.1
RCON_HELPER_PORT=8099

CS2_RCON_HOST=127.0.0.1
CS2_RCON_PORT=27017
CS2_RCON_PASSWORD=
# Optional CS:S server. Leave its password empty if only running CS2.
CSS_RCON_HOST=127.0.0.1
CSS_RCON_PORT=27015
CSS_RCON_PASSWORD=
# Optional Steam display-name API; OpenID login does not need this.
STEAM_WEB_API_KEY=
